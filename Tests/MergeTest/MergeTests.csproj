<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RocksDbPackageVersion>11.8.1.4423</RocksDbPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- We need the local RocksDbSharp project for the C# API, and the published package for its
         per-RID native binaries. -->
    <ProjectReference Include="..\..\csharp\RocksDbSharp.csproj" />

    <!-- The local project declares <PackageId>RocksDB</PackageId>, so a normal
         <PackageReference Include="RocksDB" .../> is resolved against it and
         the public NuGet package is never fetched - which left the copy below
         matching nothing and the stub native libraries in the output.
         PackageDownload bypasses that substitution. -->
    <PackageDownload Include="RocksDB" Version="[$(RocksDbPackageVersion)]" />

    <None Include="$(NuGetPackageRoot)rocksdb\$(RocksDbPackageVersion)\runtimes\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false"
          TargetPath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
